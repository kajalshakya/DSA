{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: Build and Run",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=gnu++14",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ]
}
